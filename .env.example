# --- PayPal (SANDBOX only) -------------------------------------------------
# developer.paypal.com > Apps & Credentials > Sandbox > your app
# Leave empty to run in DEMO MODE with a mock PayPal API.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Filled in by: npm run setup:paypal
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_BASIC=
PAYPAL_PLAN_LITE=
PAYPAL_SUBSCRIPTION_IDS=
# Webhook ID from the dashboard, used to verify webhook signatures
PAYPAL_WEBHOOK_ID=

# --- AI -----------------------------------------------------------------------
# Leave empty to use the rules fallback (clearly labelled in the UI).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- App ----------------------------------------------------------------------
PORT=3000
# Public URL (e.g. your Render URL or ngrok) so PayPal can redirect back after approvals
PUBLIC_URL=
